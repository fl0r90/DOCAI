import os
import requests
import json
import re
import time
import base64
from sqlalchemy import text, or_, and_
from ..database import engine, SessionLocal
from ..core.config import get_llm_config
from ..models import DocumentChunk, Document, ChatMessage, Case

OLLAMA_URL = os.getenv("OLLAMA_URL", "http://llm:11434")

class AgenticInvestigator:
    def __init__(self, case_id: int, user_question: str):
        self.case_id = case_id
        self.user_question = user_question
        self.active_model = "gemma4-it-q4"
        self.citations = []
        self.injected_evidence = ""
        self._gather_evidence_agnostic()

    def _gather_evidence_agnostic(self):
        """Universal Anchor Search without specific names."""
        with SessionLocal() as db:
            doc_ids = [d.id for d in db.query(Document).filter(Document.case_id == self.case_id).all()]
            if not doc_ids: return

            # Extracție ancore bazată pe pattern (Majuscule/Cifre)
            anchors = re.findall(r'[A-Z]{3,30}|\d+[\.,]\d{2}', self.user_question)
            
            all_chunks = []
            if anchors:
                cond = and_(DocumentChunk.document_id.in_(doc_ids), or_(*[DocumentChunk.content.ilike(f"%{a}%") for a in anchors]))
                all_chunks = db.query(DocumentChunk).filter(cond).limit(15).all()

            if not all_chunks:
                words = [w for w in re.findall(r'\w+', self.user_question.lower()) if len(w) >= 4]
                if words:
                    all_chunks = db.query(DocumentChunk).filter(DocumentChunk.document_id.in_(doc_ids), or_(*[DocumentChunk.content.ilike(f"%{w[:4]}%") for w in words])).limit(10).all()

            if all_chunks:
                self.injected_evidence = "--- AUTO-IDENTIFIED EVIDENCE --- \n"
                seen_ids = set()
                for r in all_chunks:
                    if r.id in seen_ids: continue
                    seen_ids.add(r.id)
                    neighbors = db.query(DocumentChunk).filter(DocumentChunk.document_id == r.document_id, DocumentChunk.id >= r.id - 1, DocumentChunk.id <= r.id + 1).order_by(DocumentChunk.id).all()
                    context = "\n".join([re.sub(r'> \[CONTEXT:.*?\]|> \[SPAȚIAL:.*?\]|={5,}', '', n.content).strip() for n in neighbors])
                    self.injected_evidence += f"[Source {r.document_id}, Page {r.page_number}]:\n{context}\n---\n"
                    self.citations.append({"doc_id": r.document_id, "page": r.page_number, "text": r.content[:200]})

    def tool_search(self, query: str):
        with SessionLocal() as db:
            doc_ids = [d.id for d in db.query(Document).filter(Document.case_id == self.case_id).all()]
            clean_q = re.sub(r'[^a-zA-Z0-9\s]', '', query).strip()
            cond = and_(DocumentChunk.document_id.in_(doc_ids), DocumentChunk.content.ilike(f"%{clean_q[:6]}%"))
            res = db.query(DocumentChunk).filter(cond).limit(5).all()
            return "\n---\n".join([f"[Doc {r.document_id}, Pag {r.page_number}]: {r.content[:800]}" for r in res])

    def tool_calculate(self, expr: str):
        try:
            expr = re.sub(r'[^0-9\+\-\*\/\.\(\), ]', '', expr)
            return f"RESULT: {eval(expr):,.2f}"
        except: return "ERROR: Calculation failed."

    def run(self):
        yield json.dumps({"type": "status", "data": "Analiză agnostică în curs..."})
        system_prompt = """You are a precision Forensic AI. Answer using ONLY the PROVIDED EVIDENCE.
If data is missing, use CALL: SEARCH(EntityName) to find it. 
Answer in ROMANIAN.

### EVIDENCE:
{self.injected_evidence}

### QUESTION:
{self.user_question}

### RESPONSE:"""
        history = ""
        for step in range(1, 4):
            prompt = f"{system_prompt}\n{history}\n"
            yield json.dumps({"type": "step", "data": f"Pas {step}: Analiză..."})
            full_resp = ""
            try:
                payload = {"model": self.active_model, "prompt": prompt, "stream": True, "options": {"temperature": 0.0, "stop": ["Observation:"]}}
                with requests.post(f"{OLLAMA_URL}/api/generate", json=payload, stream=True, timeout=300) as r:
                    for line in r.iter_lines(decode_unicode=True):
                        if line:
                            chunk = json.loads(line).get("response", "")
                            full_resp += chunk
                            yield json.dumps({"type": "chunk", "data": chunk})
            except: break
            m = re.search(r'CALL:\s*(\w+)\((.*?)\)', full_resp, re.I)
            if m:
                t_name, t_val = m.group(1).upper(), m.group(2).strip()
                yield json.dumps({"type": "tool_call", "tool": t_name, "params": t_val})
                obs = self.tool_calculate(t_val) if t_name == "CALCULATE" else self.tool_search(t_val)
                yield json.dumps({"type": "observation", "data": obs[:1000]})
                history += f"\n{full_resp}\nObservation: {obs}\n"
                continue
            if "FINAL_ANSWER" in full_resp.upper() or len(full_resp) > 50:
                ans = full_resp.replace("FINAL_ANSWER", "").strip("(): \n")
                yield json.dumps({"type": "final", "data": ans}); return

def query_investigator(case_id: int, user_question: str):
    agent = AgenticInvestigator(case_id, user_question)
    full_text = ""
    for chunk_json in agent.run():
        chunk = json.loads(chunk_json)
        if chunk.get("type") == "final": full_text = chunk["data"]
    return {"answer": full_text, "citations": agent.citations}
